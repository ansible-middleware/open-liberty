<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by Ansible (security_config role) – do not edit by hand -->
<!-- Reference: https://openliberty.io/docs/latest/security-overview.html -->
<!-- Hardening: https://openliberty.io/docs/latest/server-configuration-hardening.html -->
<server>

    <featureManager>
        <feature>{{ openliberty_security_feature }}</feature>
{% if openliberty_security_registry_type == 'ldap' %}
        <feature>{{ openliberty_security_ldap_feature }}</feature>
{% endif %}
    </featureManager>
{% if openliberty_security_registry_type == 'basic' %}

    <basicRegistry id="{{ openliberty_security_registry_id }}" realm="{{ openliberty_security_realm }}">
{% for u in openliberty_security_users %}
        <user name="{{ u.name | e }}" password="{{ u.password | e }}" />
{% endfor %}
{% for g in openliberty_security_groups %}
        <group name="{{ g.name | e }}">
{% for m in g.members | default([]) %}
            <member name="{{ m | e }}" />
{% endfor %}
        </group>
{% endfor %}
    </basicRegistry>
{% elif openliberty_security_registry_type == 'ldap' %}

    <ldapRegistry id="{{ openliberty_security_ldap_id }}"
                  realm="{{ openliberty_security_ldap_realm }}"
                  host="{{ openliberty_security_ldap_host }}"
                  port="{{ openliberty_security_ldap_port }}"
                  ldapType="{{ openliberty_security_ldap_type }}"
                  baseDN="{{ openliberty_security_ldap_base_dn | e }}"
{% if openliberty_security_ldap_bind_dn | length > 0 %}
                  bindDN="{{ openliberty_security_ldap_bind_dn | e }}"
                  bindPassword="{{ openliberty_security_ldap_bind_password | e }}"
{% endif %}
                  sslEnabled="{{ openliberty_security_ldap_ssl_enabled | bool | lower }}"
{% if openliberty_security_ldap_ssl_ref | length > 0 %}
                  sslRef="{{ openliberty_security_ldap_ssl_ref }}"
{% endif %}
                  searchTimeout="{{ openliberty_security_ldap_search_timeout }}"
    />
{% endif %}

    <webAppSecurity httpOnlyCookies="{{ openliberty_security_http_only_cookies | bool | lower }}"
                    ssoRequiresSSL="{{ openliberty_security_sso_requires_ssl | bool | lower }}"
                    allowFailOverToBasicAuth="{{ openliberty_security_allow_failover_to_basic_auth | bool | lower }}"
                    displayAuthenticationRealm="{{ openliberty_security_display_authentication_realm | bool | lower }}"
    />

    <httpSession cookieSecure="{{ openliberty_security_session_cookie_secure | bool | lower }}"
                 cookieHttpOnly="{{ openliberty_security_session_cookie_http_only | bool | lower }}"
                 cookieSameSite="{{ openliberty_security_session_cookie_same_site }}"
    />

    <ltpa expiration="{{ openliberty_security_ltpa_expiration }}"
{% if openliberty_security_ltpa_keys_password | length > 0 %}
          keysPassword="{{ openliberty_security_ltpa_keys_password | e }}"
{% endif %}
    />
{% if openliberty_security_remove_server_header | bool %}

    <httpOptions removeServerHeader="true" />
{% endif %}
{% if openliberty_security_disable_x_powered_by | bool %}

    <webContainer disableXPoweredBy="true" />
{% endif %}

</server>
